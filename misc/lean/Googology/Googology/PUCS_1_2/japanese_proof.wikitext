== 補遺 ==

SageMathによる。

<pre>
log2(x)=log(x)/log(2)
f(x)=log2(x)*(x^x+1);f
g(x)=2^x^2^(2/3);g

plot([f,g], (x, 0, 5)).show()
plot([log(f),log(g)], (x, 0, 5)).show()
plot(f(x)-g(x), (x, 0, 5)).show(ymin=-20,ymax=0)

def q():
    x=2
    xs=[x]
    lastoutat=x
    while x<16:
        dx=0
        ddx=8
        while ddx>=2^-14:
            if f(x+dx+ddx)-g(x)<0:dx+=ddx
            ddx/=2
        if x+dx-lastoutat>1/8:
            print(str(numerical_approx(x,prec=50))+" "+str(x)+" "+str(dx))
            lastoutat=x+dx
        x+=dx
        xs.append(x)
    xs=xs[:-1]+[16]
    tab=[]
    for i in range(len(xs)-1):
        a,b=xs[i],xs[i+1]
        fb,ga=f(b),g(a)
        tab.append([a,b,fb,ga,numerical_approx(fb-ga,prec=50)])
    return table([[a,b,diff] for [a,b,fb,ga,diff] in tab],header_row=["a","b","f(b)-g(a)"])

q()
</pre>

